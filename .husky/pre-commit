echo "🔍 Running pre-commit checks..."

# Leak scan of staged changes (CI runs the same scan on every push and PR)
if command -v gitleaks >/dev/null 2>&1; then
  echo "🔐 Scanning staged changes with gitleaks..."
  gitleaks git --pre-commit --staged --redact --no-banner || {
    echo "❌ gitleaks found a credential in staged changes. Remove it before committing."
    exit 1
  }
else
  echo "⚠️  gitleaks not installed; skipping local leak scan (CI will still run it). Install: brew install gitleaks"
fi

# Type check
echo "📝 Type checking..."
npm run type-check || {
  echo "❌ Type check failed. Fix TypeScript errors before committing."
  exit 1
}

echo "✅ Type check passed!"
